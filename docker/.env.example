# Copy to .env and fill in the required values before running `docker compose up -d`.

# --- Required -------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# Key of POST /v1/check. Set the same value in SilicaProxy (services.package-behavior-guardian.api-key):
# it sends it on checks and requires it back on callbacks.
PBG_API_KEY=change-me-check
# Read-only key of GET /v1/reports, for the people investigating a block (never the check key).
PBG_REPORT_API_KEY=change-me-report

# --- Optional -------------------------------------------------------------------------------
# host:port of SilicaProxy's callback-base-url on the Docker network
#PBG_CALLBACK_HOSTS=silicaproxy:8080
#PBG_ALLOW_HTTP_CALLBACKS=true
# Externally reachable URL of the reports API, put in every reason sent to SilicaProxy
#PBG_PUBLIC_BASE_URL=https://pbg.yourcompany.com
#SILICAPROXY_NETWORK=silicaproxy
#PBG_LOG_LEVEL=INFO

# Capacity: replicas x concurrency analyses at a time
#PBG_REPLICAS=2
#PBG_CONCURRENCY=2
#PBG_CPUS=4
#PBG_MEMORY_LIMIT=3g

# Database: keep PBG_REPLICAS x PBG_DB_POOL_SIZE below PBG_POSTGRES_MAX_CONNECTIONS
#PBG_DB_POOL_SIZE=5
#PBG_POSTGRES_MAX_CONNECTIONS=100
#PBG_POSTGRES_MEMORY_LIMIT=1g

#PBG_IMAGE=silicaproxy/packagebehaviorguardian:latest

# --- SilicaProxy side (its docker/.env) -----------------------------------------------------
# SILICAPROXY_EXTERNAL_VALIDATION_CALLBACK_BASE_URL=http://silicaproxy:8080
# SILICAPROXY_EXTERNALVALIDATION_SERVICES_PACKAGEBEHAVIORGUARDIAN_ENABLED=true
# SILICAPROXY_EXTERNALVALIDATION_SERVICES_PACKAGEBEHAVIORGUARDIAN_URL=http://packagebehaviorguardian:8101/v1/check
# SILICAPROXY_EXTERNALVALIDATION_SERVICES_PACKAGEBEHAVIORGUARDIAN_APIKEY=<PBG_API_KEY>
# SILICAPROXY_EXTERNALVALIDATION_SERVICES_PACKAGEBEHAVIORGUARDIAN_MODE=async
# SILICAPROXY_EXTERNALVALIDATION_SERVICES_PACKAGEBEHAVIORGUARDIAN_BLOCKING=false
# SILICAPROXY_EXTERNALVALIDATION_SERVICES_PACKAGEBEHAVIORGUARDIAN_FAILOPEN=true
# SILICAPROXY_EXTERNALVALIDATION_SERVICES_PACKAGEBEHAVIORGUARDIAN_CACHETTLMINUTES=20160
# SILICAPROXY_EXTERNALVALIDATION_SERVICES_PACKAGEBEHAVIORGUARDIAN_PENDINGTTLMINUTES=120
# SILICAPROXY_SECURITY_SSRF_PROTECTION_ENABLED=false   (the service is on the private Docker network)
